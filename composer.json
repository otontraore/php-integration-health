{
  "name": "otontraore/integration-health",
  "description": "Monitor health, latency and availability of integrations and dependencies in PHP applications.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "suggest": {
    "illuminate/support": "Laravel integration",
    "symfony/framework-bundle": "Symfony integration",
    "symfony/http-client": "HTTP health checks"
  },
  "autoload": {
    "psr-4": {
      "Oton\\IntegrationHealth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Oton\\IntegrationHealth\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
